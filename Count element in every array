class Solution {
    ArrayList<Integer> countDistinct(int arr[], int k) {
        // code here
        ArrayList<Integer>result=new ArrayList<>();
        int n=arr.length;
        for(int i=0;i<=n-k;i++){
            HashSet<Integer>hset=new HashSet<>();
            for(int j=i;j<i+k;j++){
              hset.add(arr[j]);  
            }
          result.add(hset.size());  
        }
      return result;  
    }
}
